<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <!-- 第一步：设置页 -->
    <LinearLayout
        android:id="@+id/setupPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="❤"
            android:textColor="#FF80AB"
            android:textSize="56sp"
            android:id="@+id/heartTop" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/setup_title"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/setup_sub"
            android:textColor="#F8BBD0"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_input"
            android:hint="@string/hint_name"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:padding="14dp"
            android:textColor="#3E2733"
            android:textColorHint="#C48BA0"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etMsg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_input"
            android:gravity="top"
            android:hint="@string/hint_msg"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:lines="3"
            android:padding="14dp"
            android:textColor="#3E2733"
            android:textColorHint="#C48BA0"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="220dp"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_btn_pink"
            android:text="@string/btn_start"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 第二步：表白页 -->
    <FrameLayout
        android:id="@+id/confessPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <TextView
            android:id="@+id/heartBig"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="90dp"
            android:text="❤"
            android:textColor="#FF1744"
            android:textSize="96sp" />

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="210dp"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAsk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="250dp"
            android:layout_marginRight="24dp"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:lineSpacingExtra="4dp" />

        <Button
            android:id="@+id/btnYes"
            android:layout_width="150dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:layout_marginTop="56dp"
            android:background="@drawable/bg_btn_pink"
            android:text="@string/btn_yes"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnNo"
            android:layout_width="130dp"
            android:layout_height="46dp"
            android:layout_gravity="bottom"
            android:layout_marginLeft="32dp"
            android:layout_marginBottom="72dp"
            android:background="@drawable/bg_btn_gray"
            android:text="@string/btn_no"
            android:textAllCaps="false"
            android:textColor="#6B5560"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvSuccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:padding="24dp"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

</FrameLayout>
